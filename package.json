{
  "name": "dev-loop",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:hooks": "for f in test/hooks/*.test.mjs; do node \"$f\" || exit 1; done",
    "build": "tsc",
    "check-auth": "node --env-file=\"${DEVLOOP_ENV_FILE:-.env}\" scripts/check-jira-auth.mjs",
    "stats": "node scripts/stats.mjs",
    "dashboard": "node src/dashboard/server.ts",
    "sandbox:approvals": "node scripts/sandbox-approvals.mjs",
    "sbx:status": "node scripts/sbx.mjs status",
    "sbx:dashboard": "node scripts/sbx.mjs dashboard",
    "sbx:preflight": "node --env-file=\"${DEVLOOP_ENV_FILE:-.env}\" src/main.ts --project=webtarsthree --sandbox=sbx --preflight-only",
    "sbx:cleanup": "node scripts/sbx.mjs cleanup",
    "sbx:smoke": "node scripts/sbx.mjs smoke",
    "sbx:template": "node scripts/sbx.mjs template",
    "sbx:template:build": "node scripts/sbx.mjs template:build",
    "claude:sbx": "node scripts/claude-sbx.mjs sbx",
    "claude:sbx:sync": "node scripts/claude-sbx.mjs sbx:sync",
    "cutover:migrate": "node scripts/migrate-v1-folders.mjs",
    "cutover:relabel": "node --env-file=\"${DEVLOOP_ENV_FILE:-.env}\" scripts/relabel-v1-refined.mjs",
    "loop": "node --env-file=\"${DEVLOOP_ENV_FILE:-.env}\" src/main.ts",
    "reset-project": "node --env-file-if-exists=\"${DEVLOOP_ENV_FILE:-.env}\" src/core/reset-cli.ts",
    "reset-project:remote": "node --env-file-if-exists=\"${DEVLOOP_ENV_FILE:-.env}\" src/core/reset-cli.ts",
    "setup-qa": "playwright install chromium",
    "eval": "bash evals/run.sh"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
